# ---- Required ----
# The FULL contents of the service account's JSON key (paste it as one line), or that JSON base64-encoded.
GOOGLE_SERVICE_ACCOUNT_JSON=
# ID of the spreadsheet that has the "Businesses" sheet (the one your Apps Script was attached to).
REGISTRY_SHEET_ID=

# ---- Recommended ----
# Your Vercel site address(es), comma separated, no trailing slash. Example: https://my-app.vercel.app
ALLOWED_ORIGINS=*
# Used for receipt times
TZ_NAME=Africa/Lagos
# Needed only for the one-time /admin/setup call for a new Services business
ADMIN_TOKEN=
# How long (seconds) a read-only copy of a sheet may be reused. Writes always read fresh data.
SHEET_CACHE_SECONDS=20
