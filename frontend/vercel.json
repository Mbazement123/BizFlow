{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "same-origin" }
      ]
    },
    {
      "source": "/js/config.js",
      "headers": [ { "key": "Cache-Control", "value": "no-cache" } ]
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://bizflow-0lli.onrender.com/api/:path*" },
    { "source": "/admin/:path*", "destination": "https://bizflow-0lli.onrender.com/admin/:path*" },
    { "source": "/health", "destination": "https://bizflow-0lli.onrender.com/health" }
  ]
}
