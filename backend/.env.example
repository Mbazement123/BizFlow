# ---- Database (required) ----
# MongoDB connection string (MongoDB Atlas or local). Example:
#   mongodb+srv://user:password@cluster.mongodb.net/bizflow?retryWrites=true&w=majority
DATABASE_URL=
MONGODB_URI=

# ---- CORS (recommended for production) ----
# Comma-separated exact origins allowed to call the API, no trailing slash.
# Example: https://my-app.vercel.app,http://localhost:3000
# Leave blank or "*" to allow all origins (not recommended in production).
ALLOWED_ORIGINS=https://my-app.vercel.app,http://localhost:3000
# Vercel project prefix (part before the "-hash") so preview deploys are allowed.
# Example: if your production URL is https://my-app.vercel.app, prefix = my-app
VERCEL_PROJECT_PREFIX=

# ---- Onboarding / auth ----
# Public FRONTEND URL. Used for the post-verify redirect (and as a fallback for the link base).
# Example: https://my-app.vercel.app
APP_BASE_URL=
# Public BACKEND URL — where /api/onboard/verify lives. This is the base of the link in the
# verification email, so it MUST point at the Render service, not the Vercel frontend.
# Example: https://my-service.onrender.com
PUBLIC_BACKEND_URL=
# Brevo SMTP Configuration (https://www.brevo.com)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# From address for emails.
MAIL_FROM=Bizflow <no-reply@bizflow.app>
# How long a login session stays valid (hours). Default 168 (7 days).
SESSION_TTL_HOURS=168
# Require the user to verify their email before the account is activated.
# Set to "false" to skip verification: accounts are activated immediately on signup.
REQUIRE_EMAIL_VERIFICATION=true

# ---- Other ----
# Used for receipt times
TZ_NAME=Africa/Lagos
# Needed only for the one-time /admin/setup call for a new Services business
ADMIN_TOKEN=
