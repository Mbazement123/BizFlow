{
  "name": "business-manager-api",
  "version": "2.0.0",
  "private": true,
  "description": "Express backend for the Sales + Services app (PostgreSQL)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --env-file=.env server.js",
