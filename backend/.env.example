# ---- Database (required) ----
# PostgreSQL connection string. Example:
#   postgresql://user:password@host:5432/database?sslmode=require
# (Render: use the Postgres "Internal Database URL" here for the web service.)
DATABASE_URL=

# ---- CORS (recommended for production) ----
# Comma-separated exact origins allowed to call the API, no trailing slash.
# Example: https://my-app.vercel.app,http://localhost:3000
# Leave blank or "*" to allow all origins (not recommended in production).
ALLOWED_ORIGINS=https://my-app.vercel.app,http://localhost:3000
# Vercel project prefix (part before the "-hash") so preview deploys are allowed.
# Example: if your production URL is https://my-app.vercel.app, prefix = my-app
VERCEL_PROJECT_PREFIX=

# ---- Onboarding / auth ----
# Public frontend URL; used to build the email verification link and the post-verify redirect.
# Example: https://my-app.vercel.app
APP_BASE_URL=
# Resend API key (https://resend.com). If blank, emails are logged to the console (dev only).
RESEND_API_KEY=
# From address for emails. Must be a verified domain/sender in Resend.
MAIL_FROM=Bizflow <onboarding@resend.dev>
# How long a login session stays valid (hours). Default 168 (7 days).
SESSION_TTL_HOURS=168

# ---- Other ----
# Used for receipt times
TZ_NAME=Africa/Lagos
# Needed only for the one-time /admin/setup call for a new Services business
ADMIN_TOKEN=
