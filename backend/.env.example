# ---- Database (required) ----
# PostgreSQL connection string (Railway / Neon / Supabase). Example:
#   postgresql://user:password@host:5432/database?sslmode=require
DATABASE_URL=

# ---- Recommended ----
# Your Vercel site address(es), comma separated, no trailing slash. Example: https://my-app.vercel.app
ALLOWED_ORIGINS=*
# Used for receipt times
TZ_NAME=Africa/Lagos
# Needed only for the one-time /admin/setup call for a new Services business
ADMIN_TOKEN=
